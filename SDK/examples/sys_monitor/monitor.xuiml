<xuiml title="NewSoft System Monitor (SDK)" width="420" height="300">
  <tab title="Telemetria">
    <groupbox x="16" y="42" w="388" h="190" title="Stato Sistema via NSRT.DLL v2.0">
      <label id="lbl_user" x="28" y="68" text="Utente: ..." color="#1A2230" />
      <label id="lbl_res" x="28" y="94" text="Schermo: ..." color="#1A2230" />
      <label id="lbl_disk" x="28" y="120" text="Cluster liberi C:\: ..." color="#17803D" />
      <label id="lbl_net" x="28" y="146" text="Rete: ..." color="#1D6FE8" />
      <label id="lbl_drives" x="28" y="172" text="Unita montate: ..." color="#5B687C" />
    </groupbox>
    <button id="btn_refresh" x="16" y="248" w="120" h="30" text="Aggiorna" />
    <button id="btn_close" x="304" y="248" w="100" h="30" text="Chiudi" />
  </tab>
</xuiml>
